echo "============================================="
echo "   OM SHELL ULTIMATE 3.0 DEMONSTRATION       "
echo "============================================="

FILE_PATH="/var/log/system/audit.log.tar.gz"
echo "[1] Parameter Expansions on: ${FILE_PATH}"
echo "    Basename (##*/): ${FILE_PATH##*/}"
echo "    Dirname (%/*):   ${FILE_PATH%/*}"
echo "    Strip ext (%.*): ${FILE_PATH%.*}"
echo "    Stem (%%.*):     ${FILE_PATH%%.*}"

NAME="om shell ultimate 3.0"
echo "    Uppercase (^^):  ${NAME^^}"
echo "    Capitalize (^):  ${NAME^}"

GREETING="Hello world, world"
echo "    Replace (/):     ${GREETING/world/OM}"
echo "    Replace All (//):${GREETING//world/OM}"

echo "[2] Array Subsystem"
declare -a sparse_list=([1]=first [4]=fourth [8]=eighth)
echo "    Sparse array size: ${#sparse_list[@]}"
echo "    Index 4 element:   ${sparse_list[4]}"

declare -A server_config=([host]=127.0.0.1 [port]=8080 [protocol]=https)
echo "    Associative array host: ${server_config[host]}:${server_config[port]}"
echo "    Associative array keys: ${!server_config[@]}"

echo "[3] Compound Conditions & Arithmetic"
TEST_VAL="version-3.0.0"
if [[ "$TEST_VAL" =~ ^version-[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "    Regex check: MATCHED semantic version pattern"
fi

if [[ "$TEST_VAL" == *.0 ]]; then
    echo "    Glob check: MATCHED *.0 pattern"
fi

(( val1 = 15, val2 = 25 ))
(( sum = val1 + val2 ))
echo "    Arithmetic evaluation: 15 + 25 = $sum"

echo "[4] Case Pattern Matching"
MODE="production"
case "$MODE" in
    dev|development)
        echo "    Mode: Development environment"
        ;;
    prod|production)
        echo "    Mode: Production environment"
        ;;
    *)
        echo "    Mode: Unknown"
        ;;
esac

echo "[5] Extended Redirections"
cat <<< "    Here-string data passed cleanly into stdin"

echo "============================================="
echo "   All 3.0 Features Executed Successfully!   "
echo "============================================="
