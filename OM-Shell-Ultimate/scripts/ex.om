
echo "Starting OM Shell script"

PROJECT="OM"
echo "Project name: ${PROJECT}"

CURRENT_FOLDER="$(pwd)"
echo "Current folder: ${CURRENT_FOLDER}"

if [ -d "$CURRENT_FOLDER" ]; then
    echo "The current folder exists."
else
    echo "The current folder does not exist."
fi

for item in one two three; do
    echo "Loop item: $item"
done

COUNT=1
while [ "$COUNT" -le 3 ]; do
    echo "Count: $COUNT"
    COUNT=$((COUNT + 1))
done

false
echo "Exit status of false: $?"
true
echo "Exit status of true: $?"
