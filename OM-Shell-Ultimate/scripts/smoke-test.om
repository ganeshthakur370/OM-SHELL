
TEST_ROOT="$(mktemp -d)"
trap 'rm -rf "$TEST_ROOT"' EXIT

fail() {
    echo "FAIL: $1" >&2
    exit 1
}

pass() {
    echo "PASS: $1"
}

cd "$TEST_ROOT" || fail "temporary directory"

alias sayhello='echo hello from alias'
ALIAS_RESULT="$(sayhello)"
[ "$ALIAS_RESULT" = "hello from alias" ] || fail "alias expansion"
pass "aliases"

USER_NAME="OM Shell"
[ "$USER_NAME" = "OM Shell" ] || fail "user variable"
pass "user-defined variables"

SUBSTITUTION_RESULT="$(printf 'command substitution works')"
[ "$SUBSTITUTION_RESULT" = "command substitution works" ] || fail "command substitution"
pass "command substitution"

if [ -d "$TEST_ROOT" ]; then
    IF_RESULT="if works"
else
    fail "if/else"
fi
[ "$IF_RESULT" = "if works" ] || fail "if/else result"
pass "if / else"

FOR_RESULT=""
for value in alpha beta gamma; do
    FOR_RESULT="${FOR_RESULT}${value} "
done
[ "$FOR_RESULT" = "alpha beta gamma " ] || fail "for loop"
pass "for loop"

COUNTER=0
while [ "$COUNTER" -lt 3 ]; do
    COUNTER=$((COUNTER + 1))
done
[ "$COUNTER" -eq 3 ] || fail "while loop"
pass "while loop"

PIPE_RESULT="$(printf 'pear\napple\nplum\n' | grep apple | wc -l | tr -d ' ')"
[ "$PIPE_RESULT" = "1" ] || fail "pipeline"
pass "pipelines"

printf 'redirect test\n' > output.txt
[ "$(cat output.txt)" = "redirect test" ] || fail "output redirection"
pass "redirection"

false
[ "$?" -eq 1 ] || fail "non-zero exit status"
true
[ "$?" -eq 0 ] || fail "zero exit status"
pass "exit status"

command-that-does-not-exist >/dev/null 2>&1
MISSING_STATUS=$?
[ "$MISSING_STATUS" -eq 127 ] || fail "command-not-found status"
pass "error handling and command-not-found status"

sleep 0.1 &
BACKGROUND_PID=$!
wait "$BACKGROUND_PID"
[ "$?" -eq 0 ] || fail "background process and wait"
pass "background process and wait"

echo "All OM Shell smoke tests passed."
